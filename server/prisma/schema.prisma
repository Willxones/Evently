// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organiser {
  id          String   @id @default(cuid())
  name        String
  logoImage   String
  bannerImage String
  description String
  linkedIn    String?
  twitter     String?
  website     String?
  userId      String   @unique()
  events      Event[]
  createdAt   DateTime @default(now())
}

model Event {
  id          String      @id @default(cuid())
  name        String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  image       String?
  eventStatus EventStatus @default(DRAFT)
  organiserId String
  organiser   Organiser   @relation(fields: [organiserId], references: [id])
  ticketTypes TicketType[]
  createdAt   DateTime    @default(now())

  @@index([organiserId])
}

enum EventStatus{
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model TicketType {
  id          String   @id @default(cuid())
  name        String   // e.g. "VIP", "General Admission"
  description String?
  price       Int      // Stored in cents (Stripe style: 100 = £1.00)
  quantity    Int      // Total available
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  tickets     Ticket[]
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model Ticket {
  id           String       @id @default(cuid())
  ticketTypeId String
  profileId    String
  status       TicketStatus @default(UNUSED)
  qrCodeId     String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  profile      Profile?     @relation(fields: [profileId], references: [id])
  purchases    Purchase[]
  issuedAt     DateTime     @default(now())
  
  @@index([ticketTypeId])
}

enum TicketStatus {
  UNUSED
  USED
  CANCELLED
}


model Profile {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  location  String
  bio       String?
  image     String?
  interests String[]
  linkedIn  String?
  github    String?
  twitter   String?
  website   String?
  userId    String   @unique()
  tickets   Ticket[]
  purchases Purchase[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Purchase {
  id          String         @id @default(cuid())
  profileId   String
  totalAmount Int
  status      PurchaseStatus @default(PENDING)
  profile     Profile        @relation(fields: [profileId], references: [id])
  tickets     Ticket[]
  createdAt   DateTime       @default(now())
  //stripeSessionId String
  //stripePaymentIntentId String?

  @@index([profileId])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}